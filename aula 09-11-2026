//(URI 1013) Faça um programa que leia 10 valores e apresente o maior dos 10 valores lidos seguido da mensagem “eh o maior”. Utilize a fórmula:
//função, bloco de código reutilizavel com um operação de uso comum
// tipo nome_da_função ( lista de _parametros dna forma TIPO nome_do_parametro

int maior ( int a, int b){
	return (a+b+abs(a-b))/2;
}

int main(int argc, char *argv[]) {
	int vet [10];
	int i , maior_valor;
	
	for(i=0; i<10; i++) scanf ("%d" , &vet[i]);
	
	maior_valor = vet[0];
	
	for(i=0, maior_valor = vet[i]; i<10; i++){
		maior_valor = maior(maior_valor, vet[i]);	
	}
	printf ("%d eh o maior:", maior_valor);
	
	
	return 0;
}
